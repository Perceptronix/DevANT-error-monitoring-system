# =============================================================================
# Error Monitoring Agent - Configuration
# =============================================================================
# This demo showcases how to build intelligent error monitoring with Airweave.
# 
# QUICK START (minimal config):
#   1. Set AIRWEAVE_API_KEY and AIRWEAVE_COLLECTION_ID
#   2. Set ANTHROPIC_API_KEY (or OPENAI_API_KEY)
#   3. Run the demo!
#
# Everything else is optional - the demo works with sample data by default.
# =============================================================================

# =============================================================================
# REQUIRED: Airweave Configuration
# =============================================================================
# Sign up at https://airweave.ai to get your API key
# Create a collection and connect your data sources (GitHub, Linear, etc.)

AIRWEAVE_API_KEY=your_airweave_api_key
AIRWEAVE_API_URL=https://api.airweave.ai
AIRWEAVE_COLLECTION_ID=your_collection_id

# =============================================================================
# REQUIRED: LLM Provider (choose one)
# =============================================================================
# Used for semantic clustering, severity analysis, and summarization

# Option 1: Anthropic (recommended)
ANTHROPIC_API_KEY=your_anthropic_api_key
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Option 2: OpenAI
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_MODEL=gpt-4o

# =============================================================================
# OPTIONAL: Data Source
# =============================================================================
# By default, uses sample data for demo purposes.
# Set DATA_SOURCE to connect to a real error monitoring system.
#
# Options: "sample" (default), "azure", "sentry", "datadog"

# DATA_SOURCE=sample

# --- Azure Log Analytics ---
# AZURE_LOG_ANALYTICS_WORKSPACE_ID=your_workspace_id
# AZURE_LOG_ANALYTICS_CLIENT_ID=your_client_id
# AZURE_LOG_ANALYTICS_CLIENT_SECRET=your_client_secret
# AZURE_LOG_ANALYTICS_TENANT_ID=your_tenant_id

# --- Sentry ---
# SENTRY_AUTH_TOKEN=your_auth_token
# SENTRY_ORG_SLUG=your_org
# SENTRY_PROJECT_SLUG=your_project
# SENTRY_URL=https://sentry.io

# --- Datadog ---
# DATADOG_API_KEY=your_api_key
# DATADOG_APP_KEY=your_app_key
# DATADOG_SITE=datadoghq.com

# =============================================================================
# OPTIONAL: Linear Integration
# =============================================================================
# Enable to create real Linear tickets instead of previews.
# Set LINEAR_ENABLED=true and provide credentials.

# LINEAR_ENABLED=false
# LINEAR_API_KEY=your_linear_api_key
# LINEAR_TEAM_ID=your_team_id

# =============================================================================
# OPTIONAL: Slack Integration
# =============================================================================
# Enable to post real Slack alerts instead of previews.
# Set SLACK_ENABLED=true and provide credentials.
#
# Create a Slack app at https://api.slack.com/apps with:
# - chat:write permission
# - Bot token (xoxb-...)

# SLACK_ENABLED=false
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_CHANNEL_ID=C0123456789
# SLACK_SIGNING_SECRET=your_signing_secret
